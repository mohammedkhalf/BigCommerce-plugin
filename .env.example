APP_NAME="BigCommerce Tamara App"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=https://app.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bigcommerce_app
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# When developing through ngrok, run a second tunnel for Vite (e.g. `ngrok http 5173`)
# and set this to that tunnel's HTTPS URL so the browser can load assets without loopback CORS errors.
# VITE_DEV_SERVER_URL=https://your-vite-tunnel.ngrok-free.dev

BIGCOMMERCE_CLIENT_ID=
BIGCOMMERCE_CLIENT_SECRET=
BIGCOMMERCE_APP_ID=
BIGCOMMERCE_AUTH_CALLBACK="${APP_URL}/auth"
BIGCOMMERCE_OAUTH_URL=https://login.bigcommerce.com/oauth2/token
BIGCOMMERCE_API_URL=https://api.bigcommerce.com
BIGCOMMERCE_PAID_STATUS_ID=11
# Optional sha384/sha512 integrity value for the deployed checkout asset.
BIGCOMMERCE_CHECKOUT_SCRIPT_SRI=
BIGCOMMERCE_JWT_ISSUER=bc
APP_SESSION_JWT_SECRET=

TAMARA_MODE=sandbox
TAMARA_SANDBOX_URL=https://api-sandbox.tamara.co
TAMARA_PRODUCTION_URL=https://api.tamara.co
